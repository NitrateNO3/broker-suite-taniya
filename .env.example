# Optional — where free-trial enquiries are delivered.
# Without one of these the form still works: it falls back to opening a
# prefilled email instead of silently failing or faking success.
#
# Option 1 — Resend (https://resend.com). Mail is sent to `trialInbox`.
# Signing up with that same Gmail address lets the default shared sender
# deliver to it with no DNS setup at all.
RESEND_API_KEY=
# Verified sender, e.g. "BrokrSuite <noreply@brokrsuite.in>". Optional.
TRIAL_MAIL_FROM=

# Option 2 — any endpoint that accepts a JSON POST (Formspree, Basin, n8n…).
TRIAL_WEBHOOK=
