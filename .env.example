# Optional — where account-deletion requests are delivered.
# Without one of these the form still works: it falls back to opening a
# prefilled email to the support address instead of silently failing.
#
# Option 1 — Resend (https://resend.com). Mail is sent to contact.email.
RESEND_API_KEY=
# Verified sender, e.g. "BrokrSuite <noreply@brokrsuite.com>". Falls back to
# Resend's shared onboarding sender, which only delivers to your own address.
ACCOUNT_DELETION_FROM=

# Option 2 — any endpoint that accepts a JSON POST (Formspree, Basin, n8n…).
ACCOUNT_DELETION_WEBHOOK=
