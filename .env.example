# Free-trial enquiries are delivered without any configuration: the API route
# relays them through FormSubmit to the address in `trialInbox`. That inbox has
# to click FormSubmit's one-time "Activate Form" link before anything arrives.
#
# Set either of the following to bypass FormSubmit and send directly instead.
#
# Option 1 — Resend (https://resend.com). Signing up with the same address as
# `trialInbox` lets the default shared sender reach it with no DNS setup.
RESEND_API_KEY=
# Verified sender, e.g. "BrokrSuite <noreply@brokrsuite.in>". Optional.
TRIAL_MAIL_FROM=

# Option 2 — any endpoint that accepts a JSON POST (Formspree, Basin, n8n…).
TRIAL_WEBHOOK=
