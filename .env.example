# Where free-trial enquiries are delivered. Set ONE of these in Vercel.
#
# Option 1 (recommended) — Web3Forms. Free, no dashboard: enter the destination
# address at https://web3forms.com and it emails you an access key. Works from
# the server on any domain, with no per-origin activation.
WEB3FORMS_ACCESS_KEY=

# Option 2 — Resend (https://resend.com). Signing up with the same address as
# `trialInbox` lets the default shared sender reach it with no DNS setup.
RESEND_API_KEY=
# Verified sender, e.g. "BrokrSuite <noreply@brokrsuite.in>". Optional.
TRIAL_MAIL_FROM=

# Option 3 — any endpoint that accepts a JSON POST (Formspree, Basin, n8n…).
TRIAL_WEBHOOK=

# If none are set, the form relays from the visitor's browser via FormSubmit,
# which requires that inbox to activate each origin separately. Optional alias
# id so the inbox address stays out of the client bundle.
NEXT_PUBLIC_FORMSUBMIT_ID=
